@model CrudClinica.Models.Medico

@{
    ViewData["Title"] = "Cadastrar Médico";


    var especialidades =
        ViewBag.Especialidades as List<CrudClinica.Models.Especialidade>;
}


<div class="container py-5">


    <div class="mb-4">

        <h1 class="fw-bold text-success mb-1">

            <i class="bi bi-person-plus-fill me-2"></i>

            Cadastrar Médico

        </h1>

        <p class="text-secondary mb-0">

            Cadastre um novo médico na clínica.

        </p>

    </div>


    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-4 p-md-5">

            <form asp-controller="Medicos"
                  asp-action="Cadastrar"
                  method="post">


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="mb-4">

                    <label asp-for="nome"
                           class="form-label fw-semibold">

                        <i class="bi bi-person me-1"></i>

                        Nome

                    </label>

                    <input asp-for="nome"
                           class="form-control form-control-lg"
                           placeholder="Digite o nome do médico" />

                    <span asp-validation-for="nome"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="crm"
                           class="form-label fw-semibold">

                        <i class="bi bi-card-text me-1"></i>

                        CRM

                    </label>

                    <input asp-for="crm"
                           class="form-control form-control-lg"
                           placeholder="Digite o CRM" />

                    <span asp-validation-for="crm"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="idEspecialidade"
                           class="form-label fw-semibold">

                        <i class="bi bi-heart-pulse me-1"></i>

                        Especialidade

                    </label>

                    <select asp-for="idEspecialidade"
                            class="form-select form-select-lg">

                        <option value="">
                            Selecione uma especialidade
                        </option>

                        @if (especialidades != null)
                        {
                            foreach (var especialidade in especialidades)
                            {
                                <option value="@especialidade.idEspecialidade">

                                    @especialidade.nome

                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="idEspecialidade"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex flex-column flex-md-row gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-success btn-lg">

                        <i class="bi bi-check-circle-fill me-1"></i>

                        Cadastrar

                    </button>


                    <a asp-controller="Medicos"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg">

                        <i class="bi bi-arrow-left me-1"></i>

                        Voltar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}