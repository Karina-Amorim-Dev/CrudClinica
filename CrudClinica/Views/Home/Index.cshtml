@{
    ViewData["Title"] = "Clínica Médica";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <div class="mb-3">

            <i class="bi bi-hospital text-primary"
               style="font-size: 4rem;">
            </i>

        </div>

        <h1 class="display-4 fw-bold text-primary">
            Clínica Médica
        </h1>

        <p class="lead text-secondary mb-3">
            Sistema de gerenciamento da Clínica Médica
        </p>

        <hr class="w-25 mx-auto">

    </div>


    <div class="row g-4 justify-content-center">

        <div class="col-12 col-md-6">

            <div class="card h-100 border-0 shadow rounded-4">

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <i class="bi bi-person-vcard text-primary"
                           style="font-size: 3.5rem;">
                        </i>

                    </div>

                    <h3 class="fw-bold">
                        Pacientes
                    </h3>

                    <p class="text-secondary">
                        Cadastre, consulte, edite e gerencie
                        os pacientes da clínica.
                    </p>

                    <a asp-controller="Pacientes"
                       asp-action="Index"
                       class="btn btn-primary px-4">

                        <i class="bi bi-arrow-right-circle"></i>
                        Acessar Pacientes

                    </a>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-6">

            <div class="card h-100 border-0 shadow rounded-4">

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <i class="bi bi-person-badge text-success"
                           style="font-size: 3.5rem;">
                        </i>

                    </div>

                    <h3 class="fw-bold">
                        Médicos
                    </h3>

                    <p class="text-secondary">
                        Cadastre, consulte, edite e gerencie
                        os médicos da clínica.
                    </p>

                    <a asp-controller="Medicos"
                       asp-action="Index"
                       class="btn btn-success px-4">

                        <i class="bi bi-arrow-right-circle"></i>
                        Acessar Médicos

                    </a>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-6">

            <div class="card h-100 border-0 shadow rounded-4">

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <i class="bi bi-heart-pulse text-danger"
                           style="font-size: 3.5rem;">
                        </i>

                    </div>

                    <h3 class="fw-bold">
                        Especialidades
                    </h3>

                    <p class="text-secondary">
                        Cadastre, consulte, edite e gerencie
                        as especialidades médicas.
                    </p>

                    <a asp-controller="Especialidades"
                       asp-action="Index"
                       class="btn btn-danger px-4">

                        <i class="bi bi-arrow-right-circle"></i>
                        Acessar Especialidades

                    </a>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-6">

            <div class="card h-100 border-0 shadow rounded-4">

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <i class="bi bi-calendar2-check text-warning"
                           style="font-size: 3.5rem;">
                        </i>

                    </div>

                    <h3 class="fw-bold">
                        Consultas
                    </h3>

                    <p class="text-secondary">
                        Cadastre, consulte, edite e gerencie
                        as consultas médicas.
                    </p>

                    <a asp-controller="Consultas"
                       asp-action="Index"
                       class="btn btn-warning px-4">

                        <i class="bi bi-arrow-right-circle"></i>
                        Acessar Consultas

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>