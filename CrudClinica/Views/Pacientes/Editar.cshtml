@model CrudClinica.Models.Paciente

@{
    ViewData["Title"] = "Editar Paciente";
}

<div class="container py-5">


    <div class="mb-4">

        <h1 class="fw-bold text-primary mb-1">

            <i class="bi bi-pencil-square me-2"></i>

            Editar Paciente

        </h1>

        <p class="text-secondary mb-0">

            Altere os dados do paciente cadastrado.

        </p>

    </div>


    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-4 p-md-5">

            <form asp-action="Editar" method="post">


                <input asp-for="idPaciente"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="mb-4">

                    <label asp-for="nome"
                           class="form-label fw-semibold">

                        <i class="bi bi-person me-1"></i>

                        Nome

                    </label>

                    <input asp-for="nome"
                           class="form-control form-control-lg"
                           placeholder="Digite o nome do paciente" />

                    <span asp-validation-for="nome"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="cpf"
                           class="form-label fw-semibold">

                        <i class="bi bi-card-text me-1"></i>

                        CPF

                    </label>

                    <input asp-for="cpf"
                           class="form-control form-control-lg"
                           placeholder="Digite o CPF" />

                    <span asp-validation-for="cpf"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="telefone"
                           class="form-label fw-semibold">

                        <i class="bi bi-telephone me-1"></i>

                        Telefone

                    </label>

                    <input asp-for="telefone"
                           class="form-control form-control-lg"
                           placeholder="Digite o telefone" />

                    <span asp-validation-for="telefone"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="dataNasc"
                           class="form-label fw-semibold">

                        <i class="bi bi-calendar-event me-1"></i>

                        Data de Nascimento

                    </label>

                    <input asp-for="dataNasc"
                           type="date"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="dataNasc"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex flex-column flex-md-row gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary btn-lg">

                        <i class="bi bi-check-circle-fill me-1"></i>

                        Salvar Alterações

                    </button>


                    <a asp-controller="Pacientes"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg">

                        <i class="bi bi-arrow-left me-1"></i>

                        Voltar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}